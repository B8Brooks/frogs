# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — it stays on your machine only.

# A random secret for signing auth tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-random-string

# The URL where your app is running.
# Local dev: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Your login username.
ADMIN_USERNAME=admin

# Bcrypt hash of your password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 10))"
ADMIN_PASSWORD_HASH=replace-me-with-bcrypt-hash

# Anthropic API key for AI frog sizing.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Database connection string.
# Local: file:./dev.db (if using SQLite - note: change provider in schema.prisma)
# Vercel Postgres: provided automatically via POSTGRES_PRISMA_URL env var
DATABASE_URL=postgresql://user:password@host:5432/dbname
